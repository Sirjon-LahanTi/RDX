---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SNX Beast - Monster Truck Crushing & Survival">
  <div class="simulation-container" id="simContainer">
    <!-- TOP STATUS & SURVIVAL TELEMETRY BAR -->
    <header class="top-nav">
      <div class="brand">
        <div class="brand-badge">CHALLENGE</div>
        <h1>SNX <span>BEAST-66</span></h1>
      </div>
      
      <!-- SURVIVAL STATS (HEALTH, FUEL, SCORE, DISTANCE) -->
      <div class="survival-hud">
        <!-- Health Bar -->
        <div class="hud-meter-card">
          <div class="meter-header">
            <span class="meter-icon">🛡️</span>
            <span class="meter-label">HULL INTEGRITY</span>
            <span class="meter-value" id="healthVal">100%</span>
          </div>
          <div class="meter-track">
            <div class="meter-fill fill-health" id="healthBar"></div>
          </div>
        </div>

        <!-- Fuel Bar -->
        <div class="hud-meter-card">
          <div class="meter-header">
            <span class="meter-icon">⛽</span>
            <span class="meter-label">FUEL TANK</span>
            <span class="meter-value" id="fuelVal">100%</span>
          </div>
          <div class="meter-track">
            <div class="meter-fill fill-fuel" id="fuelBar"></div>
          </div>
        </div>

        <!-- Score & Distance & Crush Counter -->
        <div class="score-card">
          <div class="score-pill">
            <span class="label">SCORE</span>
            <span class="val" id="scoreDisplay">0</span>
          </div>
          <div class="score-pill">
            <span class="label">DIST</span>
            <span class="val" id="distDisplay">0m</span>
          </div>
          <div class="score-pill crush-pill">
            <span class="label">CRUSHED</span>
            <span class="val val-crush" id="crushDisplay">0</span>
          </div>
        </div>
      </div>

      <div class="top-actions">
        <button class="icon-btn" id="soundBtn" title="Toggle Sound [M]">
          <svg viewBox="0 0 24 24" class="icon"><path fill="currentColor" d="M14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77zm-2.5 9.77H8l-4 4V7l4 4h3.5v2zM16.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
          <span class="sound-text">SOUND: ON</span>
        </button>
        <button class="icon-btn" id="themeBtn" title="Toggle Lighting [L]">
          <svg viewBox="0 0 24 24" class="icon"><path fill="currentColor" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 17.93V4.07a8 8 0 0 1 0 15.86z"/></svg>
          <span id="lightingModeText">NEON NIGHT</span>
        </button>
      </div>
    </header>

    <!-- FLOATING CORNER SPEEDOMETER & TACHOMETER CLUSTER (TOP-RIGHT: ZERO CAR OBSTRUCTION) -->
    <aside class="corner-hud-cluster">
      <div class="cluster-gauge">
        <svg class="gauge-svg" viewBox="0 0 240 180">
          <path d="M 30,145 A 90,90 0 1,1 210,145" fill="none" stroke="#1e293b" stroke-width="10" stroke-linecap="round"/>
          <path d="M 30,145 A 90,90 0 1,1 210,145" fill="none" stroke="url(#speedGlowGrad)" stroke-width="10" 
                stroke-linecap="round" stroke-dasharray="350" stroke-dashoffset="350" id="gaugeSpeedArc"/>
          <path d="M 175,42 A 90,90 0 0,1 210,145" fill="none" stroke="#ff0055" stroke-width="5" opacity="0.6"/>

          <g id="speedNeedle" transform="rotate(-130, 120, 125)">
            <polygon points="117,125 123,125 121,30 119,30" fill="#00f3ff"/>
            <circle cx="120" cy="125" r="12" fill="#0f172a" stroke="#00f3ff" stroke-width="2.5"/>
            <circle cx="120" cy="125" r="4" fill="#ffffff"/>
          </g>

          <defs>
            <linearGradient id="speedGlowGrad" x1="0%" y1="100%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#00f3ff"/>
              <stop offset="60%" stop-color="#a3e635"/>
              <stop offset="85%" stop-color="#f59e0b"/>
              <stop offset="100%" stop-color="#ff0055"/>
            </linearGradient>
          </defs>
        </svg>

        <div class="gauge-center-content">
          <div class="digital-speed" id="speedDigit">0</div>
          <div class="speed-unit">KM / H</div>
          <div class="gear-badge" id="gearIndicator">P</div>
        </div>

        <div class="rpm-strip">
          <span class="rpm-label">RPM</span>
          <div class="rpm-bar-track">
            <div class="rpm-bar-fill" id="rpmBar"></div>
          </div>
          <span class="rpm-val" id="rpmVal">850</span>
        </div>
      </div>
    </aside>

    <!-- WORLD SCENE VIEWPORT -->
    <div class="viewport" id="viewport">
      <!-- PARALLAX ENVIRONMENT LAYERS -->
      <div class="sky-gradient"></div>
      <div class="stars-layer" id="starsLayer"></div>
      <div class="city-skyline" id="citySkyline"></div>
      <div class="midground-layer" id="midgroundLayer"></div>
      <div class="speed-lines" id="speedLines"></div>

      <!-- MODERN CYBER ROAD -->
      <div class="ground-complex">
        <div class="road-surface" id="roadSurface">
          <div class="road-grid"></div>
          <div class="road-lanes" id="roadLanes"></div>
          <div class="road-reflectors"></div>
          <div class="curb-neon-left"></div>
          <div class="curb-neon-right"></div>
        </div>
      </div>

      <!-- DYNAMIC OBSTACLE & COLLECTIBLES LAYER (CARS, BARRELS, FUEL CANS) -->
      <div class="obstacles-layer" id="obstaclesLayer"></div>

      <!-- FLOATING COMBAT TEXT & POPUPS -->
      <div class="popups-layer" id="popupsLayer"></div>

      <!-- VOLUMETRIC VEHICLE HEADLIGHT BEAM -->
      <div class="headlight-volumetric" id="headlightCone">
        <div class="beam-glow"></div>
        <div class="beam-dust" id="beamDust"></div>
      </div>

      <!-- ROAD SKID MARKS & TIRE SMOKE PARTICLES -->
      <div class="tire-smoke-layer" id="tireSmokeLayer"></div>

      <!-- THE MONSTER TRUCK: FACING RIGHT & ELEVATED ABOVE ROAD -->
      <div class="truck-assembly" id="truckAssembly">
        <svg class="truck-svg" viewBox="0 0 850 560" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="chromeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ffffff"/>
              <stop offset="25%" stop-color="#94a3b8"/>
              <stop offset="50%" stop-color="#f8fafc"/>
              <stop offset="75%" stop-color="#475569"/>
              <stop offset="100%" stop-color="#cbd5e1"/>
            </linearGradient>

            <linearGradient id="cageGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#ff7b00"/>
              <stop offset="45%" stop-color="#ff4800"/>
              <stop offset="100%" stop-color="#b32400"/>
            </linearGradient>

            <linearGradient id="springGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#ffd000"/>
              <stop offset="50%" stop-color="#ff9900"/>
              <stop offset="100%" stop-color="#cc6600"/>
            </linearGradient>

            <linearGradient id="bodyPaint" x1="0%" y1="0%" x2="100%" y2="70%">
              <stop offset="0%" stop-color="#d4ff00"/>
              <stop offset="30%" stop-color="#a3e635"/>
              <stop offset="70%" stop-color="#65a30d"/>
              <stop offset="100%" stop-color="#365314"/>
            </linearGradient>

            <linearGradient id="windowTint" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#0284c7" stop-opacity="0.85"/>
              <stop offset="50%" stop-color="#0369a1" stop-opacity="0.95"/>
              <stop offset="100%" stop-color="#082f49" stop-opacity="0.95"/>
            </linearGradient>

            <radialGradient id="rubberTire" cx="50%" cy="50%" r="50%">
              <stop offset="60%" stop-color="#1e2229"/>
              <stop offset="85%" stop-color="#12151a"/>
              <stop offset="98%" stop-color="#090a0d"/>
              <stop offset="100%" stop-color="#000000"/>
            </radialGradient>

            <radialGradient id="rimGrad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#475569"/>
              <stop offset="35%" stop-color="#0f172a"/>
              <stop offset="75%" stop-color="#1e293b"/>
              <stop offset="88%" stop-color="#ff4400"/>
              <stop offset="100%" stop-color="#0a0a0a"/>
            </radialGradient>

            <filter id="brakeGlow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="blur"/>
              <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>

            <radialGradient id="xenonBulb" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ffffff"/>
              <stop offset="30%" stop-color="#cffafe"/>
              <stop offset="70%" stop-color="#38bdf8"/>
              <stop offset="100%" stop-color="#0284c7"/>
            </radialGradient>
          </defs>

          <!-- ROOT CAR GROUP FLIPPED TO FACE FORWARD TOWARDS THE RIGHT -->
          <g transform="translate(850, 0) scale(-1, 1)">
            <line x1="280" y1="410" x2="570" y2="410" stroke="#1e293b" stroke-width="18" stroke-linecap="round"/>
            <line x1="280" y1="410" x2="570" y2="410" stroke="#475569" stroke-width="6" stroke-dasharray="16,8"/>

            <!-- BACK WHEEL - REAR LEFT -->
            <g class="wheel-group wheel-rear-back" id="wheelRearBack" transform="translate(590, 410) scale(0.92)">
              <circle r="96" fill="#15181e" stroke="#090a0c" stroke-width="5"/>
              <g class="tire-lugs" stroke="#252b36" stroke-width="12" stroke-linecap="round">
                <path d="M-88,-35 L-65,-15 L-88,5 M-65,30 L-45,50 L-65,70 M-10,75 L15,90 L-10,95 M40,75 L65,60 L85,75 M75,10 L90,-15 L75,-35 M45,-65 L65,-85 L45,-95 M-20,-85 L-40,-70 L-65,-85" />
              </g>
              <circle r="52" fill="#0f172a" stroke="#1e293b" stroke-width="6"/>
              <circle r="22" fill="#334155" stroke="#090a0c" stroke-width="3"/>
            </g>

            <!-- BACK WHEEL - FRONT LEFT -->
            <g class="wheel-group wheel-front-back" id="wheelFrontBack" transform="translate(260, 410) scale(0.92)">
              <circle r="96" fill="#15181e" stroke="#090a0c" stroke-width="5"/>
              <g class="tire-lugs" stroke="#252b36" stroke-width="12" stroke-linecap="round">
                <path d="M-88,-35 L-65,-15 L-88,5 M-65,30 L-45,50 L-65,70 M-10,75 L15,90 L-10,95 M40,75 L65,60 L85,75 M75,10 L90,-15 L75,-35 M45,-65 L65,-85 L45,-95 M-20,-85 L-40,-70 L-65,-85" />
              </g>
              <circle r="52" fill="#0f172a" stroke="#1e293b" stroke-width="6"/>
              <circle r="22" fill="#334155" stroke="#090a0c" stroke-width="3"/>
            </g>

            <!-- 4-LINK SUSPENSION, CHROMOLY ROLL CAGE, CHASSIS -->
            <g class="center-drivetrain">
              <rect x="400" y="380" width="55" height="45" rx="8" fill="#1e293b" stroke="#475569" stroke-width="4"/>
              <circle cx="427" cy="402" r="14" fill="#0f172a" stroke="#ff5500" stroke-width="3"/>
              <line x1="400" y1="400" x2="270" y2="415" stroke="url(#chromeGrad)" stroke-width="8" stroke-linecap="round"/>
              <line x1="455" y1="400" x2="585" y2="415" stroke="url(#chromeGrad)" stroke-width="8" stroke-linecap="round"/>
            </g>

            <g class="suspension-links" stroke="url(#cageGrad)" stroke-width="10" stroke-linecap="round">
              <line x1="380" y1="340" x2="270" y2="415"/>
              <line x1="380" y1="365" x2="270" y2="430"/>
              <line x1="470" y1="340" x2="585" y2="415"/>
              <line x1="470" y1="365" x2="585" y2="430"/>
            </g>

            <g class="coilovers">
              <g class="shock front-shock">
                <rect x="315" y="290" width="12" height="38" rx="4" fill="#0284c7" stroke="#ffffff" stroke-width="1.5"/>
                <line x1="310" y1="280" x2="270" y2="415" stroke="url(#chromeGrad)" stroke-width="14" stroke-linecap="round"/>
                <path d="M305,295 L275,310 L305,325 L275,340 L305,355 L275,370 L305,385 L275,400"
                      fill="none" stroke="url(#springGrad)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
              </g>

              <g class="shock rear-shock">
                <rect x="530" y="290" width="12" height="38" rx="4" fill="#0284c7" stroke="#ffffff" stroke-width="1.5"/>
                <line x1="540" y1="280" x2="585" y2="415" stroke="url(#chromeGrad)" stroke-width="14" stroke-linecap="round"/>
                <path d="M545,295 L575,310 L545,325 L575,340 L545,355 L575,370 L545,385 L575,400"
                      fill="none" stroke="url(#springGrad)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
            </g>

            <g class="tubular-chassis" stroke="url(#cageGrad)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round">
              <line x1="280" y1="340" x2="570" y2="340"/>
              <line x1="285" y1="340" x2="425" y2="280"/>
              <line x1="425" y1="280" x2="565" y2="340"/>
              <line x1="285" y1="280" x2="425" y2="340"/>
              <line x1="425" y1="340" x2="565" y2="280"/>
              <line x1="425" y1="275" x2="425" y2="345" stroke="#ff3b00" stroke-width="11"/>
              <line x1="270" y1="280" x2="580" y2="280" stroke="#ffaa00" stroke-width="8"/>
            </g>

            <g class="underglow">
              <line x1="280" y1="345" x2="570" y2="345" stroke="#00f3ff" stroke-width="6" opacity="0.85" filter="url(#brakeGlow)"/>
            </g>

            <!-- TRUCK BODY -->
            <g class="truck-body-mount" id="truckBody">
              <g class="exhaust-headers">
                <path d="M600,240 C630,245 650,230 670,220" fill="none" stroke="url(#chromeGrad)" stroke-width="12" stroke-linecap="round"/>
                <path d="M605,250 C635,255 655,240 675,230" fill="none" stroke="url(#chromeGrad)" stroke-width="11" stroke-linecap="round"/>
                <ellipse cx="673" cy="223" rx="5" ry="9" fill="#0f172a" stroke="#ff4400" stroke-width="2"/>
              </g>

              <path class="body-shell" d="
                M 170, 245
                C 165, 230 180, 200 205, 185
                L 285, 175
                C 315, 140 340, 105 385, 95
                L 510, 95
                C 545, 95 565, 125 580, 155
                L 645, 160
                C 665, 162 675, 180 675, 205
                L 670, 250
                C 670, 260 655, 265 640, 265
                L 590, 265
                C 585, 240 560, 225 530, 225
                C 500, 225 480, 240 470, 265
                L 350, 265
                C 340, 240 320, 225 290, 225
                C 260, 225 240, 240 230, 265
                L 185, 265
                C 175, 265 170, 255 170, 245 Z
              " fill="url(#bodyPaint)" stroke="#1a2e05" stroke-width="5" stroke-linejoin="round"/>

              <g class="supercharger-assembly">
                <path d="M 270,178 L 290,140 L 335,140 L 345,178 Z" fill="url(#chromeGrad)" stroke="#1e293b" stroke-width="3"/>
                <rect x="295" y="122" width="40" height="20" rx="4" fill="#0f172a" stroke="#ff2200" stroke-width="2"/>
                <ellipse cx="305" cy="132" rx="4" ry="7" fill="#ff3300"/>
                <ellipse cx="317" cy="132" rx="4" ry="7" fill="#ff3300"/>
                <ellipse cx="329" cy="132" rx="4" ry="7" fill="#ff3300"/>
                <circle cx="280" cy="165" r="9" fill="#0f172a" stroke="url(#chromeGrad)" stroke-width="3"/>
                <circle cx="280" cy="188" r="14" fill="#0f172a" stroke="url(#chromeGrad)" stroke-width="3"/>
                <line x1="272" y1="165" x2="267" y2="188" stroke="#000" stroke-width="4"/>
                <line x1="288" y1="165" x2="293" y2="188" stroke="#000" stroke-width="4"/>
              </g>

              <g class="decals">
                <path d="M 230,225 L 340,210 L 480,215 L 610,195 L 560,230 L 420,235 Z" fill="#ff5500" opacity="0.85"/>
                <path d="M 280,220 L 380,212 L 460,214 L 540,202 L 500,225 Z" fill="#ffdd00" opacity="0.9"/>
                <g transform="translate(440, 235) scale(-1, 1)">
                  <text x="0" y="0" text-anchor="middle" font-family="'Orbitron', sans-serif" font-weight="900" font-size="28" fill="#ffffff" font-style="italic" letter-spacing="2">66</text>
                </g>
                <g transform="translate(350, 235) scale(-1, 1)">
                  <text x="0" y="0" text-anchor="middle" font-family="'Orbitron', sans-serif" font-weight="800" font-size="13" fill="#0f172a" font-style="italic">BEAST</text>
                </g>
              </g>

              <path class="windshield" d="
                M 320, 170
                L 380, 108
                L 440, 108
                L 440, 170
                Z
              " fill="url(#windowTint)" stroke="#0f172a" stroke-width="3"/>

              <path class="side-window" d="
                M 452, 110
                L 505, 110
                L 540, 165
                L 452, 168
                Z
              " fill="url(#windowTint)" stroke="#0f172a" stroke-width="3"/>

              <polygon points="315,168 375,108 395,108 335,168" fill="#ffffff" opacity="0.25"/>

              <circle cx="475" cy="138" r="14" fill="#090d16"/>
              <rect x="466" y="134" width="10" height="5" rx="2" fill="#00f3ff"/>

              <rect x="365" y="96" width="145" height="10" rx="3" fill="#0f172a" stroke="#475569" stroke-width="2"/>
              <circle cx="380" cy="101" r="3" fill="#00f3ff" class="roof-led"/>
              <circle cx="400" cy="101" r="3" fill="#00f3ff" class="roof-led"/>
              <circle cx="420" cy="101" r="3" fill="#00f3ff" class="roof-led"/>
              <circle cx="440" cy="101" r="3" fill="#00f3ff" class="roof-led"/>
              <circle cx="460" cy="101" r="3" fill="#00f3ff" class="roof-led"/>
              <circle cx="480" cy="101" r="3" fill="#00f3ff" class="roof-led"/>
              <circle cx="500" cy="101" r="3" fill="#00f3ff" class="roof-led"/>

              <g class="rear-spoiler">
                <line x1="600" y1="160" x2="630" y2="95" stroke="url(#chromeGrad)" stroke-width="6" stroke-linecap="round"/>
                <line x1="625" y1="160" x2="645" y2="95" stroke="url(#chromeGrad)" stroke-width="6" stroke-linecap="round"/>
                <path d="M 590,92 L 670,82 L 672,96 L 592,106 Z" fill="#0f172a" stroke="#ff4800" stroke-width="3"/>
                <polygon points="665,72 682,70 678,112 660,110" fill="#ff4800"/>
              </g>

              <g class="front-bumper">
                <path d="M 155,230 L 175,225 L 180,265 L 150,260 Z" fill="#1e293b" stroke="#475569" stroke-width="2"/>
                <path d="M 175,225 L 140,200 L 135,240 L 165,260" fill="none" stroke="url(#cageGrad)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
                <rect x="150" y="235" width="18" height="14" rx="3" fill="#0f172a" stroke="#94a3b8" stroke-width="1.5"/>
                <line x1="148" y1="242" x2="140" y2="242" stroke="#ffcc00" stroke-width="3"/>
              </g>

              <g class="headlights" id="truckHeadlightUnit">
                <polygon points="168,205 195,198 190,225 165,222" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                <ellipse cx="178" cy="212" rx="7" ry="6" fill="url(#xenonBulb)" filter="url(#brakeGlow)"/>
                <ellipse cx="178" cy="212" rx="3" ry="2.5" fill="#ffffff"/>
              </g>

              <rect x="668" y="195" width="7" height="28" rx="2" fill="#ff0044" filter="url(#brakeGlow)" id="taillightBar"/>
            </g>

            <!-- TIRE WHEELS -->
            <g class="wheel-group wheel-rear-front" id="wheelRearFront" transform="translate(565, 410)">
              <circle r="105" fill="url(#rubberTire)" stroke="#090a0d" stroke-width="4"/>
              <g class="tire-treads" stroke="#333c4a" stroke-width="14" stroke-linecap="round">
                <path d="M -96,-38 L -72,-16 L -96,6" />
                <path d="M -72,32 L -48,54 L -72,76" />
                <path d="M -12,82 L 16,98 L -12,104" />
                <path d="M 44,82 L 72,66 L 94,82" />
                <path d="M 82,12 L 98,-16 L 82,-38" />
                <path d="M 50,-72 L 72,-94 L 50,-104" />
                <path d="M -22,-94 L -44,-76 L -72,-94" />
              </g>
              <circle r="82" fill="none" stroke="#232832" stroke-width="22" stroke-dasharray="14,10"/>
              <circle r="52" fill="#1e293b" stroke="#64748b" stroke-width="3" id="brakeDiscRear"/>
              <circle r="42" fill="none" stroke="#0f172a" stroke-width="4" stroke-dasharray="6,8"/>
              <path d="M -40,-35 Q -54,-10 -40,15 L -26,10 Q -38,-10 -26,-30 Z" fill="#ff1e00" stroke="#b91c1c" stroke-width="2"/>
              <circle r="58" fill="url(#rimGrad)" stroke="#ff4d00" stroke-width="5"/>
              <circle r="54" fill="none" stroke="#e2e8f0" stroke-width="3" stroke-dasharray="2,11.5"/>
              <circle r="26" fill="#0f172a" stroke="#64748b" stroke-width="4"/>
              <circle r="18" fill="none" stroke="#f8fafc" stroke-width="3" stroke-dasharray="2,9"/>
              <circle r="10" fill="#334155" stroke="#ff5500" stroke-width="2"/>
            </g>

            <g class="wheel-group wheel-front-front" id="wheelFrontFront" transform="translate(285, 410)">
              <circle r="105" fill="url(#rubberTire)" stroke="#090a0d" stroke-width="4"/>
              <g class="tire-treads" stroke="#333c4a" stroke-width="14" stroke-linecap="round">
                <path d="M -96,-38 L -72,-16 L -96,6" />
                <path d="M -72,32 L -48,54 L -72,76" />
                <path d="M -12,82 L 16,98 L -12,104" />
                <path d="M 44,82 L 72,66 L 94,82" />
                <path d="M 82,12 L 98,-16 L 82,-38" />
                <path d="M 50,-72 L 72,-94 L 50,-104" />
                <path d="M -22,-94 L -44,-76 L -72,-94" />
              </g>
              <circle r="82" fill="none" stroke="#232832" stroke-width="22" stroke-dasharray="14,10"/>
              <circle r="52" fill="#1e293b" stroke="#64748b" stroke-width="3" id="brakeDiscFront"/>
              <circle r="42" fill="none" stroke="#0f172a" stroke-width="4" stroke-dasharray="6,8"/>
              <path d="M -40,-35 Q -54,-10 -40,15 L -26,10 Q -38,-10 -26,-30 Z" fill="#ff1e00" stroke="#b91c1c" stroke-width="2"/>
              <circle r="58" fill="url(#rimGrad)" stroke="#ff4d00" stroke-width="5"/>
              <circle r="54" fill="none" stroke="#e2e8f0" stroke-width="3" stroke-dasharray="2,11.5"/>
              <circle r="26" fill="#0f172a" stroke="#64748b" stroke-width="4"/>
