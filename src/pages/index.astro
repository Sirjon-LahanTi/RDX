        <button class="restart-btn" id="restartBtn">
          <span>DEPLOY NEW TRUCK</span>
          <kbd>[ENTER / SPACE]</kbd>
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ======================================================== */
  /* ROOT CONTAINER & LAYOUT                                  */
  /* ======================================================== */
  .simulation-container {
    position: relative;
    width: 100vw;
