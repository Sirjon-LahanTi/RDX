      <div class="hud-quadrant quadrant-center">
        <div class="control-toast">
          <span>GOAL:</span>
          Crush Scrap Cars 🚗 &bull; Avoid Barrels 🛢️ &bull; Grab Fuel ⛽ &bull; Keep Speed High!
        </div>
      </div>

      <div class="hud-quadrant quadrant-right">
        <div class="boost-module">
          <button class="nitro-card" id="nitroBtn" title="Hold [SHIFT] for NOS Turbo Boost">
