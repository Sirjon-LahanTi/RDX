    font-size: 8px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 1px;
  }
  .score-pill .val {
    font-family: 'Orbitron', monospace;
    font-size: 13px;
    font-weight: 800;
    color: #fff;
  }
