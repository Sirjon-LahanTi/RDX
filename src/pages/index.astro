        <div class="pedal-wrapper">
          <button class="pedal-btn gas-pedal" id="gasPedal" title="Hold [W] or [Up Arrow] to Accelerate">
            <div class="pedal-grip"><span></span><span></span><span></span><span></span><span></span></div>
            <div class="pedal-label">THROTTLE</div>
            <div class="pedal-key-hint">HOLD [W / ↑]</div>
          </button>
        </div>
      </div>
    </footer>

    <!-- GAME OVER / MISSION REPORT MODAL -->
    <div class="game-over-modal" id="gameOverModal">
      <div class="modal-card">
        <div class="modal-badge" id="modalBadge">MISSION FAILED</div>
