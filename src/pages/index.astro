  .brand h1 span {
    color: var(--primary-neon);
    text-shadow: 0 0 12px rgba(0,243,255,0.6);
  }

  /* SURVIVAL TELEMETRY HUD (HEALTH, FUEL, SCORE) */
  .survival-hud {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .hud-meter-card {
    background: rgba(15,23,42,0.85);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    padding: 6px 14px;
