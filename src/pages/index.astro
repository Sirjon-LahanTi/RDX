              <div class="nitro-fill" id="nitroBar"></div>
            </div>
            <div class="nitro-btn-body">
              <svg viewBox="0 0 24 24" class="flame-icon"><path fill="currentColor" d="M17.5 12a5.5 5.5 0 1 1-11 0c0-1.68.74-3.23 2-4.25C8.85 6.7 9.5 5.4 9.5 4c0-.55-.45-1-1-1-.2 0-.39.06-.55.17C5.8 4.6 4 7.6 4 11a8 8 0 0 0 16 0c0-2.4-.9-4.7-2.5-6.4-.3-.3-.8-.3-1.1 0-.3.3-.3.8 0 1.1 1.3 1.4 2.1 3.3 2.1 5.3z"/></svg>
              <span>NITRO BOOST</span>
