</style>

<script>
  // ==========================================================
  // GAME & VEHICLE RIGGING ENGINE WITH OBSTACLES & SURVIVAL
  // ==========================================================

  const state = {
    speed: 0,
    targetSpeed: 0,
    rpm: 850,
    gear: 'P',
    isAccelerating: false,
    isBraking: false,
    isBoosting: false,
    nitroLeft: 100,
    jumpPhase: 0,
    isJumping: false,
    lightingMode: 2,
    soundEnabled: true,
    wheelAngle: 0,
    pitchAngle: 0,
    // SURVIVAL & GAMEPLAY STATS
    health: 100,
    fuel: 100,
    score: 0,
    distance: 0,
    carsCrushed: 0,
    isGameOver: false,
    climbBumpY: 0,
    highScore: parseInt(localStorage.getItem('snx_beast_high_score') || '0', 10)
  };

  // DOM Elements
  const speedDigit = document.getElementById('speedDigit')!;
  const speedNeedle = document.getElementById('speedNeedle')!;
  const gaugeSpeedArc = document.getElementById('gaugeSpeedArc')!;
  const gearIndicator = document.getElementById('gearIndicator')!;
  const rpmBar = document.getElementById('rpmBar')!;
  const rpmVal = document.getElementById('rpmVal')!;
  const nitroBar = document.getElementById('nitroBar')!;
  const nitroLevel = document.getElementById('nitroLevel')!;
  const nitroBtn = document.getElementById('nitroBtn')!;
  const gasPedal = document.getElementById('gasPedal')!;
  const brakePedal = document.getElementById('brakePedal')!;
  const jumpBtn = document.getElementById('jumpBtn')!;
  const lightsToggleBtn = document.getElementById('lightsToggleBtn')!;
  const lightsModeText = document.getElementById('lightingModeText')!;
  const lightsStatusLabel = document.getElementById('lightsStatusLabel')!;
  const headlightCone = document.getElementById('headlightCone')!;
  const soundBtn = document.getElementById('soundBtn')!;
  const soundText = soundBtn.querySelector('.sound-text')!;
  const truckAssembly = document.getElementById('truckAssembly')!;
  const exhaustFlame = document.getElementById('exhaustFlame')!;
  const brakeDiscFront = document.getElementById('brakeDiscFront')!;
  const brakeDiscRear = document.getElementById('brakeDiscRear')!;
  const tireSmokeLayer = document.getElementById('tireSmokeLayer')!;
  const roadLanes = document.getElementById('roadLanes')!;
  const citySkyline = document.getElementById('citySkyline')!;
  const midgroundLayer = document.getElementById('midgroundLayer')!;
  const obstaclesLayer = document.getElementById('obstaclesLayer')!;
  const popupsLayer = document.getElementById('popupsLayer')!;

  // Survival HUD DOM
  const healthBar = document.getElementById('healthBar')!;
  const healthVal = document.getElementById('healthVal')!;
  const fuelBar = document.getElementById('fuelBar')!;
  const fuelVal = document.getElementById('fuelVal')!;
  const scoreDisplay = document.getElementById('scoreDisplay')!;
  const distDisplay = document.getElementById('distDisplay')!;
  const crushDisplay = document.getElementById('crushDisplay')!;

  // Game Over Modal DOM
  const gameOverModal = document.getElementById('gameOverModal')!;
  const modalTitle = document.getElementById('modalTitle')!;
  const finalScore = document.getElementById('finalScore')!;
  const finalDist = document.getElementById('finalDist')!;
  const finalCrushed = document.getElementById('finalCrushed')!;
  const highScoreVal = document.getElementById('highScoreVal')!;
  const restartBtn = document.getElementById('restartBtn')!;

  // Wheel Elements
  const wf = document.getElementById('wheelFrontFront');
  const wr = document.getElementById('wheelRearFront');
  const wfb = document.getElementById('wheelFrontBack');
  const wrb = document.getElementById('wheelRearBack');

  // ==========================================================
  // PROCEDURAL WEB AUDIO SYNTHESIZER (ENGINE + CRUNCH + EXPLOSION + CHIME)
  // ==========================================================
  let audioCtx: AudioContext | null = null;
  let engineOsc1: OscillatorNode | null = null;
  let engineOsc2: OscillatorNode | null = null;
  let engineGain: GainNode | null = null;

  function initAudio() {
    if (audioCtx) return;
    try {
      const AudioCtxClass = window.AudioContext || (window as any).webkitAudioContext;
      audioCtx = new AudioCtxClass();

      engineGain = audioCtx.createGain();
      engineGain.gain.setValueAtTime(0.12, audioCtx.currentTime);
      engineGain.connect(audioCtx.destination);

      engineOsc1 = audioCtx.createOscillator();
      engineOsc1.type = 'sawtooth';
      engineOsc1.frequency.setValueAtTime(32, audioCtx.currentTime);

      engineOsc2 = audioCtx.createOscillator();
      engineOsc2.type = 'triangle';
      engineOsc2.frequency.setValueAtTime(64, audioCtx.currentTime);

      const filter = audioCtx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(380, audioCtx.currentTime);

      engineOsc1.connect(filter);
      engineOsc2.connect(filter);
      filter.connect(engineGain);

      engineOsc1.start();
      engineOsc2.start();
    } catch (e) {}
  }

  function updateAudioPitch() {
    if (!audioCtx || !state.soundEnabled || !engineOsc1 || !engineOsc2 || !engineGain) return;
    const baseFreq = 28 + (state.rpm / 8500) * 135;
    engineOsc1.frequency.setTargetAtTime(baseFreq, audioCtx.currentTime, 0.05);
    engineOsc2.frequency.setTargetAtTime(baseFreq * 1.5, audioCtx.currentTime, 0.05);

    const targetVol = state.isBoosting ? 0.28 : state.isAccelerating ? 0.22 : 0.09;
    engineGain.gain.setTargetAtTime(targetVol, audioCtx.currentTime, 0.05);
  }

  // SATISFYING METAL CRUNCH SOUND FOR CRUSHING CARS
  function playMetalCrunch() {
    if (!audioCtx || !state.soundEnabled) return;
    try {
      // Noise burst for crunch
      const bufferSize = audioCtx.sampleRate * 0.35;
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = Math.random() * 2 - 1;
      }
      const noise = audioCtx.createBufferSource();
      noise.buffer = buffer;

      const filter = audioCtx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.setValueAtTime(750, audioCtx.currentTime);
      filter.Q.setValueAtTime(3, audioCtx.currentTime);

      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(0.4, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.35);

      noise.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);
      noise.start();
    } catch(e) {}
  }

  // EXPLOSION SOUND FOR HAZARD BARRELS
  function playExplosion() {
    if (!audioCtx || !state.soundEnabled) return;
    try {
      const boomOsc = audioCtx.createOscillator();
      const boomGain = audioCtx.createGain();
      boomOsc.type = 'sawtooth';
      boomOsc.frequency.setValueAtTime(140, audioCtx.currentTime);
      boomOsc.frequency.exponentialRampToValueAtTime(25, audioCtx.currentTime + 0.5);

      boomGain.gain.setValueAtTime(0.5, audioCtx.currentTime);
      boomGain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);

      boomOsc.connect(boomGain);
      boomGain.connect(audioCtx.destination);
      boomOsc.start();
      boomOsc.stop(audioCtx.currentTime + 0.5);
    } catch(e) {}
  }

  // REWARD CHIME FOR FUEL CANISTER PICKUP
  function playFuelPickup() {
    if (!audioCtx || !state.soundEnabled) return;
    try {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // C5
      osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.08); // E5
      osc.frequency.setValueAtTime(783.99, audioCtx.currentTime + 0.16); // G5
      osc.frequency.setValueAtTime(1046.50, audioCtx.currentTime + 0.24); // C6

      gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.45);

      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.45);
    } catch(e) {}
  }

  function playBrakeScreech() {
    if (!audioCtx || !state.soundEnabled || state.speed < 25) return;
    try {
      const screechOsc = audioCtx.createOscillator();
      const screechGain = audioCtx.createGain();
      screechOsc.type = 'sawtooth';
      screechOsc.frequency.setValueAtTime(1400 + Math.random() * 300, audioCtx.currentTime);
      screechGain.gain.setValueAtTime(0.08, audioCtx.currentTime);
      screechGain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.35);
      screechOsc.connect(screechGain);
      screechGain.connect(audioCtx.destination);
      screechOsc.start();
      screechOsc.stop(audioCtx.currentTime + 0.35);
    } catch(e) {}
  }

  function playHydraulicBounceSound() {
    if (!audioCtx || !state.soundEnabled) return;
    try {
      const hopOsc = audioCtx.createOscillator();
      const hopGain = audioCtx.createGain();
      hopOsc.type = 'sine';
      hopOsc.frequency.setValueAtTime(180, audioCtx.currentTime);
      hopOsc.frequency.exponentialRampToValueAtTime(45, audioCtx.currentTime + 0.3);
      hopGain.gain.setValueAtTime(0.3, audioCtx.currentTime);
      hopGain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
      hopOsc.connect(hopGain);
      hopGain.connect(audioCtx.destination);
      hopOsc.start();
      hopOsc.stop(audioCtx.currentTime + 0.3);
    } catch(e) {}
  }

  // Stars
  const starsContainer = document.getElementById('starsLayer')!;
  for (let i = 0; i < 90; i++) {
    const star = document.createElement('div');
    star.className = 'sky-star';
    const sz = 1 + Math.random() * 2.5;
    star.style.width = sz + 'px';
    star.style.height = sz + 'px';
    star.style.left = (Math.random() * 100) + '%';
    star.style.top = (Math.random() * 60) + '%';
    star.style.animationDelay = (Math.random() * 3) + 's';
    starsContainer.appendChild(star);
  }

  // ==========================================================
  // FLOATING COMBAT TEXT HELPER
  // ==========================================================
  function showFloatingPopup(text: string, type: 'crush' | 'fuel' | 'damage', x: number, y: number) {
    const pop = document.createElement('div');
    pop.className = `float-popup pop-${type}`;
    pop.textContent = text;
    pop.style.left = x + 'px';
    pop.style.top = y + 'px';
    popupsLayer.appendChild(pop);
    setTimeout(() => pop.remove(), 950);
  }

  // ==========================================================
  // DYNAMIC OBSTACLE SPAWNER & MANAGEMENT
  // ==========================================================
  interface Obstacle {
    id: number;
    type: 'car' | 'barrel' | 'fuel';
    x: number;
    width: number;
    height: number;
    isCrushed?: boolean;
    isCollected?: boolean;
    element: HTMLElement;
  }

  let obstacles: Obstacle[] = [];
  let obstacleIdCounter = 0;
  let lastSpawnDistance = 0;

  function spawnObstacle() {
    if (state.speed < 5 || state.isGameOver) return;

    // Pick a type: 55% crushable car, 25% hazard barrel, 20% fuel can
    const r = Math.random();
    let type: 'car' | 'barrel' | 'fuel' = 'car';
    if (r > 0.80) type = 'fuel';
    else if (r > 0.55) type = 'barrel';

    const el = document.createElement('div');
    const startX = window.innerWidth + 120;
    let w = 140, h = 50;

    if (type === 'car') {
      el.className = 'scrap-car';
      w = 140; h = 50;
      // Procedural colorful scrap car body
      const carColor = ['#ef4444', '#3b82f6', '#a855f7', '#eab308'][Math.floor(Math.random() * 4)];
      el.innerHTML = `
        <svg viewBox="0 0 140 50" style="width:100%;height:100%;overflow:visible;">
          <!-- Car Body -->
          <path d="M5,42 L135,42 L130,22 L100,20 L80,6 L35,6 L20,20 L5,24 Z" fill="${carColor}" stroke="#1e293b" stroke-width="2"/>
          <!-- Windows -->
          <polygon points="38,8 78,8 96,20 25,20" fill="#0f172a" opacity="0.85"/>
          <!-- Wheels -->
          <circle cx="28" cy="42" r="12" fill="#1e293b" stroke="#475569" stroke-width="2"/>
          <circle cx="112" cy="42" r="12" fill="#1e293b" stroke="#475569" stroke-width="2"/>
          <circle cx="28" cy="42" r="5" fill="#cbd5e1"/>
          <circle cx="112" cy="42" r="5" fill="#cbd5e1"/>
        </svg>
      `;
    } else if (type === 'barrel') {
      el.className = 'hazard-barrel';
      w = 38; h = 54;
      el.innerHTML = `
        <div class="barrel-rib"></div>
        <span class="hazard-symbol">☣</span>
        <div class="barrel-rib"></div>
      `;
    } else {
      el.className = 'fuel-can';
      w = 36; h = 44;
      el.innerHTML = `⛽`;
    }

    el.style.left = startX + 'px';
    obstaclesLayer.appendChild(el);

    obstacles.push({
      id: ++obstacleIdCounter,
      type,
      x: startX,
      width: w,
      height: h,
      element: el
    });
  }

  // ==========================================================
  // INPUT CONTROLS
  // ==========================================================
  function setAccelerate(val: boolean) {
    if (state.isGameOver) return;
    initAudio();
    state.isAccelerating = val;
    gasPedal.classList.toggle('pedal-active', val);
  }

  function setBrake(val: boolean) {
    if (state.isGameOver) return;
    initAudio();
    state.isBraking = val;
    brakePedal.classList.toggle('pedal-active', val);
    if (val && state.speed > 25) {
      playBrakeScreech();
    }
  }

  function setBoost(val: boolean) {
    if (state.isGameOver) return;
    initAudio();
    if (val && state.nitroLeft > 5) {
      state.isBoosting = true;
      nitroBtn.classList.add('nitro-active');
    } else {
      state.isBoosting = false;
      nitroBtn.classList.remove('nitro-active');
    }
  }

  function triggerHydraulicJump() {
    if (state.isGameOver) return;
    initAudio();
    if (state.isJumping) return;
    state.isJumping = true;
    state.jumpPhase = 0;
    playHydraulicBounceSound();
  }

  function toggleLighting() {
    state.lightingMode = (state.lightingMode + 1) % 3;
    if (state.lightingMode === 0) {
      lightsModeText.textContent = "LIGHTS: OFF";
      lightsStatusLabel.textContent = "OFF";
      headlightCone.style.opacity = '0';
      document.querySelectorAll('.roof-led').forEach((el: any) => el.style.opacity = '0.1');
    } else if (state.lightingMode === 1) {
      lightsModeText.textContent = "LOW BEAM";
      lightsStatusLabel.textContent = "LOW BEAM";
      headlightCone.style.opacity = '0.45';
      document.querySelectorAll('.roof-led').forEach((el: any) => el.style.opacity = '0.5');
    } else {
      lightsModeText.textContent = "NEON NIGHT";
      lightsStatusLabel.textContent = "HIGH BEAM";
      headlightCone.style.opacity = '1';
      document.querySelectorAll('.roof-led').forEach((el: any) => el.style.opacity = '1');
    }
  }

  // RESET & RESTART GAME FUNCTION
  function restartGame() {
    state.health = 100;
    state.fuel = 100;
    state.score = 0;
    state.distance = 0;
    state.carsCrushed = 0;
    state.speed = 0;
    state.isGameOver = false;
    state.isAccelerating = false;
    state.isBraking = false;
    state.isBoosting = false;
    state.climbBumpY = 0;

    // Clear all obstacles
    obstacles.forEach(o => o.element.remove());
    obstacles = [];

    // Reset HUD
    gameOverModal.classList.remove('modal-open');
    healthBar.style.width = '100%';
    healthVal.textContent = '100%';
    fuelBar.style.width = '100%';
    fuelVal.textContent = '100%';
    scoreDisplay.textContent = '0';
    distDisplay.textContent = '0m';
    crushDisplay.textContent = '0';
  }

  function triggerGameOver(reason: 'fuel' | 'wreck') {
    state.isGameOver = true;
    state.speed = 0;
    state.isAccelerating = false;
    state.isBoosting = false;
    exhaustFlame.style.opacity = '0';

    if (state.score > state.highScore) {
      state.highScore = state.score;
      localStorage.setItem('snx_beast_high_score', state.highScore.toString());
    }

    modalTitle.textContent = reason === 'fuel' ? 'OUT OF FUEL' : 'TRUCK DESTROYED';
    finalScore.textContent = state.score.toLocaleString();
    finalDist.textContent = Math.floor(state.distance) + 'm';
    finalCrushed.textContent = state.carsCrushed.toString();
    highScoreVal.textContent = state.highScore.toLocaleString();

    gameOverModal.classList.add('modal-open');
  }

  gasPedal.addEventListener('mousedown', () => setAccelerate(true));
  window.addEventListener('mouseup', () => {
    setAccelerate(false);
    setBrake(false);
    setBoost(false);
  });
  gasPedal.addEventListener('touchstart', (e) => { e.preventDefault(); setAccelerate(true); });
  gasPedal.addEventListener('touchend', (e) => { e.preventDefault(); setAccelerate(false); });

  brakePedal.addEventListener('mousedown', () => setBrake(true));
  brakePedal.addEventListener('touchstart', (e) => { e.preventDefault(); setBrake(true); });
  brakePedal.addEventListener('touchend', (e) => { e.preventDefault(); setBrake(false); });

  nitroBtn.addEventListener('mousedown', () => setBoost(true));
  nitroBtn.addEventListener('touchstart', (e) => { e.preventDefault(); setBoost(true); });
  nitroBtn.addEventListener('touchend', (e) => { e.preventDefault(); setBoost(false); });

  jumpBtn.addEventListener('click', triggerHydraulicJump);
  lightsToggleBtn.addEventListener('click', toggleLighting);
  restartBtn.addEventListener('click', restartGame);

  soundBtn.addEventListener('click', () => {
    initAudio();
    state.soundEnabled = !state.soundEnabled;
    soundText.textContent = state.soundEnabled ? 'SOUND: ON' : 'SOUND: OFF';
    if (!state.soundEnabled && engineGain && audioCtx) {
      engineGain.gain.setValueAtTime(0, audioCtx.currentTime);
    }
  });

  window.addEventListener('keydown', (e) => {
    initAudio();
    const key = e.key.toLowerCase();
    if (state.isGameOver) {
      if (e.code === 'Enter' || e.code === 'Space') restartGame();
      return;
    }
    if (key === 'w' || e.key === 'ArrowUp') setAccelerate(true);
    if (key === 's' || e.key === 'ArrowDown') setBrake(true);
    if (e.shiftKey) setBoost(true);
    if (e.code === 'Space') {
      e.preventDefault();
      triggerHydraulicJump();
    }
    if (key === 'l') toggleLighting();
    if (key === 'm') soundBtn.click();
    if (key === 'r') restartGame();
  });

  window.addEventListener('keyup', (e) => {
    const key = e.key.toLowerCase();
    if (key === 'w' || e.key === 'ArrowUp') setAccelerate(false);
    if (key === 's' || e.key === 'ArrowDown') setBrake(false);
    if (!e.shiftKey) setBoost(false);
  });

  // ==========================================================
  // PARTICLES
  // ==========================================================
  let lastParticleTime = 0;
  function spawnTireSmoke() {
    if (state.speed < 10 && !state.isAccelerating && !state.isBraking) return;
    const now = performance.now();
    if (now - lastParticleTime < 60) return;
    lastParticleTime = now;

    const truckRect = truckAssembly.getBoundingClientRect();
    const spawnX = truckRect.left + (truckRect.width * 0.28) + (Math.random() * 20 - 10);
    const spawnY = truckRect.top + (truckRect.height * 0.88);

    const puff = document.createElement('div');
    puff.className = 'smoke-puff';
    const sz = state.isBraking ? 28 + Math.random() * 25 : 16 + Math.random() * 20;
    puff.style.width = sz + 'px';
    puff.style.height = sz + 'px';
    puff.style.left = spawnX + 'px';
    puff.style.top = spawnY + 'px';

    tireSmokeLayer.appendChild(puff);

    const startTime = performance.now();
    const duration = 600 + Math.random() * 400;
    const moveX = -(120 + state.speed * 2.5);
    const moveY = -(20 + Math.random() * 40);

    function stepPuff(curr: number) {
      const elapsed = curr - startTime;
      const progress = elapsed / duration;
      if (progress >= 1) {
        puff.remove();
        return;
      }
      puff.style.transform = `translate(${moveX * progress}px, ${moveY * progress}px) scale(${1 + progress * 2.2})`;
      puff.style.opacity = `${(1 - progress) * 0.7}`;
      requestAnimationFrame(stepPuff);
    }
    requestAnimationFrame(stepPuff);
  }

  // ==========================================================
  // MAIN GAME & PHYSICS LOOP
  // ==========================================================
  let roadOffset = 0;
  let cityOffset = 0;
  let midOffset = 0;

  function updateSimulation() {
    if (state.isGameOver) {
      requestAnimationFrame(updateSimulation);
      return;
    }

    const maxNormalSpeed = 160;
    const maxBoostSpeed = 225;
    const currentMax = state.isBoosting ? maxBoostSpeed : maxNormalSpeed;

    // 1. Acceleration & Fuel Consumption
    if (state.isAccelerating) {
      const accelRate = state.isBoosting ? 1.6 : 0.85;
      state.speed += accelRate;
      if (state.speed > currentMax) state.speed = currentMax;

      // Fuel burn: burning more fuel while accelerating or boosting!
      const burnRate = state.isBoosting ? 0.05 : 0.02;
      state.fuel -= burnRate;
    } else {
      state.speed *= 0.988;
      if (state.speed < 0.1) state.speed = 0;
      // Idle fuel burn
      if (state.speed > 5) state.fuel -= 0.005;
    }

    // Check fuel game over
    if (state.fuel <= 0) {
      state.fuel = 0;
      triggerGameOver('fuel');
    }
    fuelBar.style.width = state.fuel + '%';
    fuelVal.textContent = Math.floor(state.fuel) + '%';

    // 2. Braking
    if (state.isBraking) {
      state.speed -= 2.2;
      if (state.speed < 0) state.speed = 0;
      const brakeHeat = Math.min(1, state.speed / 80);
      brakeDiscFront.setAttribute('fill', `rgba(255, ${Math.floor(100 - brakeHeat * 80)}, 0, ${0.4 + brakeHeat * 0.6})`);
      brakeDiscRear.setAttribute('fill', `rgba(255, ${Math.floor(100 - brakeHeat * 80)}, 0, ${0.4 + brakeHeat * 0.6})`);
    } else {
      brakeDiscFront.setAttribute('fill', '#1e293b');
      brakeDiscRear.setAttribute('fill', '#1e293b');
    }

    // 3. Nitro
    if (state.isBoosting) {
      state.nitroLeft -= 0.6;
      if (state.nitroLeft <= 0) {
        state.nitroLeft = 0;
        setBoost(false);
      }
      exhaustFlame.style.opacity = '1';
      exhaustFlame.style.transform = `scaleX(-1) scale(${1 + Math.random() * 0.3})`;
    } else {
      exhaustFlame.style.opacity = '0';
      if (state.nitroLeft < 100) state.nitroLeft += 0.08;
    }
    nitroBar.style.width = state.nitroLeft + '%';
    nitroLevel.textContent = Math.floor(state.nitroLeft) + '%';

    // 4. Transmission
    if (state.speed < 1) {
      state.gear = 'P';
      state.rpm = state.isAccelerating ? 2400 : 850;
    } else {
      const s = state.speed;
      if (s < 30) { state.gear = '1'; state.rpm = 1500 + (s / 30) * 4500; }
      else if (s < 60) { state.gear = '2'; state.rpm = 2500 + ((s - 30) / 30) * 4500; }
      else if (s < 100) { state.gear = '3'; state.rpm = 2800 + ((s - 60) / 40) * 4200; }
      else if (s < 145) { state.gear = '4'; state.rpm = 3200 + ((s - 100) / 45) * 4400; }
      else if (s < 185) { state.gear = '5'; state.rpm = 3800 + ((s - 145) / 40) * 4200; }
      else { state.gear = '6'; state.rpm = 4500 + ((s - 185) / 40) * 3800; }
    }
    gearIndicator.textContent = state.gear;
    rpmBar.style.width = Math.min(100, (state.rpm / 8500) * 100) + '%';
    rpmVal.textContent = Math.floor(state.rpm).toString();

    // 5. Speedometer Updates
    const displaySpeed = Math.floor(state.speed);
    speedDigit.textContent = displaySpeed.toString();

    const needleDeg = -130 + (Math.min(240, state.speed) / 240) * 260;
    speedNeedle.setAttribute('transform', `rotate(${needleDeg}, 120, 125)`);

    const maxOffset = 350;
    const arcPercent = Math.min(1, state.speed / 240);
    gaugeSpeedArc.setAttribute('stroke-dashoffset', (maxOffset * (1 - arcPercent)).toString());

    // 6. Distance & Score accumulation
    if (state.speed > 1) {
      const distDelta = (state.speed * (1000 / 3600)) * (1 / 60);
      state.distance += distDelta;
      state.score += Math.floor(distDelta * 2);
      distDisplay.textContent = Math.floor(state.distance) + 'm';
      scoreDisplay.textContent = state.score.toLocaleString();
    }

    // 7. Suspension & Jump Physics
    let targetPitch = 0;
    if (state.isAccelerating) targetPitch = state.isBoosting ? -3.5 : -2.0;
    if (state.isBraking) targetPitch = 3.2;
    state.pitchAngle += (targetPitch - state.pitchAngle) * 0.12;

    let jumpY = 0;
    if (state.isJumping) {
      state.jumpPhase += 0.08;
      jumpY = -Math.sin(state.jumpPhase * Math.PI) * 85 * Math.exp(-state.jumpPhase * 0.45);
      if (state.jumpPhase >= 2.5) {
        state.isJumping = false;
        state.jumpPhase = 0;
      }
    }

    // Obstacle Climb bump decay
    state.climbBumpY *= 0.88;

    // Apply Truck transform
    const forwardSurge = (state.speed / 200) * 45;
    const rumbleY = (state.speed > 5) ? (Math.random() * 2.5 - 1.25) * (state.speed / 100) : 0;
    const totalY = jumpY + rumbleY - state.climbBumpY;
    truckAssembly.style.transform = `translateX(calc(-50% + ${forwardSurge}px)) translateY(${totalY}px) rotate(${state.pitchAngle}deg)`;

    // 8. Wheels Clockwise Forward Rotation
    const wheelRotSpeed = (state.speed / 100) * 24;
    state.wheelAngle = (state.wheelAngle + wheelRotSpeed) % 360;
    const forwardWheelDeg = -state.wheelAngle;

    if (wf) wf.setAttribute('transform', `translate(285, 410) rotate(${forwardWheelDeg})`);
    if (wr) wr.setAttribute('transform', `translate(565, 410) rotate(${forwardWheelDeg})`);
    if (wfb) wfb.setAttribute('transform', `translate(260, 410) scale(0.92) rotate(${forwardWheelDeg})`);
    if (wrb) wrb.setAttribute('transform', `translate(590, 410) scale(0.92) rotate(${forwardWheelDeg})`);

    // 9. Parallax Background Motion
    const velocityFactor = state.speed * 0.35;
    roadOffset = (roadOffset - velocityFactor * 1.8) % 140;
    midOffset = (midOffset - velocityFactor * 0.25) % 800;
    cityOffset = (cityOffset - velocityFactor * 0.06) % 1200;

    roadLanes.style.transform = `translateX(${roadOffset}px)`;
    midgroundLayer.style.backgroundPosition = `${midOffset}px bottom`;
    citySkyline.style.backgroundPosition = `${cityOffset}px bottom`;

    // 10. SPAWN & UPDATE OBSTACLES (COLLISION DETECTION & CAR CRUSHING)
    if (state.distance - lastSpawnDistance > 45) {
      spawnObstacle();
      lastSpawnDistance = state.distance;
    }

    const truckRect = truckAssembly.getBoundingClientRect();
    const truckFrontX = truckRect.left + truckRect.width * 0.65;
    const truckRearX = truckRect.left + truckRect.width * 0.25;
    const isTruckAirborne = jumpY < -40; // Truck jumped high over obstacles!

    for (let i = obstacles.length - 1; i >= 0; i--) {
      const obs = obstacles[i];
      // Move obstacle leftwards with road speed
      obs.x -= velocityFactor * 1.8;
      obs.element.style.left = obs.x + 'px';

      const obsRect = obs.element.getBoundingClientRect();
      const isOverlapX = (obsRect.right > truckRearX && obsRect.left < truckFrontX);

      // COLLISION LOGIC
      if (isOverlapX && !obs.isCollected) {
        if (obs.type === 'car' && !obs.isCrushed) {
          // MONSTER TRUCK CRUSHES CAR!
          obs.isCrushed = true;
          obs.element.classList.add('crushed');
          playMetalCrunch();
          state.climbBumpY = 22; // truck body jumps up slightly climbing over car
          state.carsCrushed++;
          state.score += 150;
          crushDisplay.textContent = state.carsCrushed.toString();
          scoreDisplay.textContent = state.score.toLocaleString();
          showFloatingPopup('+150 CRUSHED!', 'crush', obsRect.left, obsRect.top - 20);

          // Spawn scrap metal debris particles
          for (let p = 0; p < 8; p++) {
            const spark = document.createElement('div');
            spark.style.cssText = `
              position: absolute; width: 6px; height: 6px; border-radius: 50%;
              background: #f59e0b; box-shadow: 0 0 10px #f59e0b;
              left: ${obsRect.left + Math.random() * 80}px;
              top: ${obsRect.top + Math.random() * 20}px;
              z-index: 200; pointer-events: none;
            `;
            popupsLayer.appendChild(spark);
            setTimeout(() => spark.remove(), 400);
          }
        } else if (obs.type === 'fuel') {
          // COLLECT FUEL!
          obs.isCollected = true;
          obs.element.remove();
          playFuelPickup();
          state.fuel = Math.min(100, state.fuel + 28);
          state.score += 50;
          scoreDisplay.textContent = state.score.toLocaleString();
          showFloatingPopup('+28% FUEL!', 'fuel', obsRect.left, obsRect.top - 20);
        } else if (obs.type === 'barrel' && !isTruckAirborne) {
          // HIT EXPLOSIVE BARREL!
          obs.isCollected = true;
          obs.element.remove();
          playExplosion();

          if (state.isBoosting) {
            // Nitro armor smashes barrel!
            state.score += 100;
            scoreDisplay.textContent = state.score.toLocaleString();
            showFloatingPopup('BARREL SMASHED! +100', 'crush', obsRect.left, obsRect.top - 20);
          } else {
            // Damage hull!
            state.health -= 20;
            state.speed *= 0.6; // slows down
            if (state.health <= 0) {
              state.health = 0;
              triggerGameOver('wreck');
            }
            healthBar.style.width = state.health + '%';
            healthVal.textContent = Math.floor(state.health) + '%';
            showFloatingPopup('-20% HULL DAMAGE!', 'damage', obsRect.left, obsRect.top - 20);

            // Red screen shake / flash
            truckAssembly.style.filter = 'drop-shadow(0 0 35px #ef4444)';
            setTimeout(() => { truckAssembly.style.filter = 'none'; }, 300);
          }
        }
      }

      // Remove obstacles that scrolled past behind the screen
      if (obs.x < -200) {
        obs.element.remove();
        obstacles.splice(i, 1);
      }
    }

    spawnTireSmoke();
    updateAudioPitch();

    requestAnimationFrame(updateSimulation);
  }

  requestAnimationFrame(updateSimulation);
</script>
